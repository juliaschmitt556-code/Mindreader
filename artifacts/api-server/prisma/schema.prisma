generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReplyTone {
  romantic
  reassuring
  sweet
  calm
  flirty
  playful
  natural
  apologetic
  confident
  short
}

enum UsageKind {
  generation
  imageAnalysis
}

enum UsageStatus {
  reserved
  completed
}

model User {
  id           String         @id
  plan         String         @default("free")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  conversations Conversation[]
  screenshots  UploadedScreenshot[]
  preference   UserPreference?
  usageRecords UsageRecord[]

  @@map("users")
}

model Conversation {
  id         String               @id @default(uuid()) @db.Uuid
  ownerId    String               @map("owner_id")
  title      String
  isArchived Boolean              @default(false) @map("is_archived")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  owner      User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages   ConversationMessage[]
  screenshots UploadedScreenshot[]
  analyses   AIAnalysis[]

  @@index([ownerId, updatedAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  speaker        String
  content        String       @db.Text
  sequence       Int
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model UploadedScreenshot {
  id             String        @id @default(uuid()) @db.Uuid
  ownerId        String        @map("owner_id")
  conversationId String?       @map("conversation_id") @db.Uuid
  objectPath     String        @unique @map("object_path")
  fileName       String        @map("file_name")
  contentType    String        @map("content_type")
  size           Int
  isRegistered   Boolean       @default(false) @map("is_registered")
  createdAt      DateTime      @default(now()) @map("created_at")
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@map("uploaded_screenshots")
}

model AIAnalysis {
  id                 String            @id @default(uuid()) @db.Uuid
  conversationId     String            @map("conversation_id") @db.Uuid
  summary            String            @db.Text
  tone               String
  relationshipContext String           @map("relationship_context") @db.Text
  intent             String            @db.Text
  needsClarification Boolean           @default(false) @map("needs_clarification")
  createdAt          DateTime          @default(now()) @map("created_at")
  conversation       Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  suggestions        ReplySuggestion[]

  @@index([conversationId, createdAt])
  @@map("ai_analyses")
}

model ReplySuggestion {
  id         String      @id @default(uuid()) @db.Uuid
  analysisId String      @map("analysis_id") @db.Uuid
  tone       ReplyTone
  text       String      @db.Text
  createdAt  DateTime    @default(now()) @map("created_at")
  analysis   AIAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, createdAt])
  @@map("reply_suggestions")
}

model UserPreference {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @map("user_id")
  defaultTone   ReplyTone @default(natural) @map("default_tone")
  includeEmojis Boolean   @default(true) @map("include_emojis")
  appearance    String    @default("system")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UsageRecord {
  id        BigInt      @id @default(autoincrement())
  ownerId   String      @map("owner_id")
  kind      UsageKind
  status    UsageStatus @default(reserved)
  createdAt DateTime    @default(now()) @map("created_at")
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, kind, createdAt])
  @@map("usage_records")
}